# CodeTrack Companion — copy to .env or set as OS env vars before launch

# REST API base (include /api)
CODETRACK_API_URL=http://localhost:3000/api

# Socket.IO origin (no /api)
CODETRACK_SOCKET_URL=http://localhost:3000

# Professor "Open dashboard" deep link
CODETRACK_DASHBOARD_URL=http://localhost:5173
