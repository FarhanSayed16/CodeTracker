PORT=3000

# --- Database (Supabase Postgres free tier) ---
# Dashboard → Project Settings → Database
# DATABASE_URL = Transaction pooler (port 6543) — use for the running app
# DIRECT_URL   = Direct connection (port 5432) — use for prisma migrate
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/code_tracker?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/code_tracker"

JWT_SECRET="your-super-secret-jwt-key"
# Professor dashboard tokens
JWT_EXPIRES_IN="24h"
# Student classroom tokens (covers 3–3.5h labs + buffer)
STUDENT_JWT_EXPIRES_IN="4h"
# Comma-separated. Companion Vite (5174) is always allowed in addition to this list.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000
STUDENT_RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40
GRACE_WINDOW_SECONDS=120

# Require students to set/verify a 4-digit PIN on join
REQUIRE_STUDENT_PIN=true

# --- Cache (Upstash Redis free tier, optional) ---
# Leave blank to use in-memory rate limits / no cache
# UPSTASH_REDIS_REST_URL="https://YOUR.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AX..."

# --- IoT / MQTT (disabled until hardware work) ---
ENABLE_MQTT=false
MQTT_URL="mqtt://localhost:1883"
# MQTT_USERNAME=
# MQTT_PASSWORD=
